<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/files/cake.png" type="image/png">
    <link rel="stylesheet" href="/css/home.css">
    <title>wishU</title>
</head>
<body>
    <div class="container">
        <div class="left">
            <div id="create"></div>
            <div id="your"></div>
            <div id="birthday"></div>
            <div id="card"></div>
        </div>

        <div class="right">
            <form action="/home" method="post" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="name">Name</label>
                    <input 
                        type="text" 
                        id="name" 
                        placeholder="Enter the name" 
                        name="naam" 
                        autocomplete="off" 
                        maxlength="16"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea 
                        id="message" 
                        placeholder="message should be short and sweet" 
                        name="message" 
                        autocomplete="off"
                        maxlength="251"
                        required
                    ></textarea>
                </div>

                <div class="top-section">
                    <div class="left-photo">
                        <img 
                            src="/files/profile.png" 
                            alt="Current Profile" 
                            class="edit-profile-img" 
                            id="profilePic"
                        >
                    </div>
                    <div class="right-actions">
                        <label for="photo" class="upload-btn">Upload Photo</label>
                        <input 
                            type="file" 
                            id="photo" 
                            name="image" 
                            required
                        >
                    </div>
                </div>

                <div>
                    <button class="submit-btn" type="submit">Create Card</button>
                </div>
            </form>
        </div>
    </div>

    <script src="/js/home.js"></script>
</body>
</html>
