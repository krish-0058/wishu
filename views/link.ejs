<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/link.css">
    <link rel="icon" href="/files/cake.png" type="image/png">
    <title>wishU</title>
</head>
<body>
    <div class="container">
        <div class="box">
            <div><h1>Link Created</h1></div>
            <div id="link" class="link"><a href=<%= shortCode %>><%= link %></a></div>
            <button onclick="copylink()">🔗</button>
        </div>

        <div class="back">
            <a href="/home"><button>Home</button></a>
        </div>
    </div>
</body>



<script>
    function copylink(){
        const link = document.getElementById("link")
        navigator.clipboard.writeText(link)
        .then(()=>{
            alert("Link copied to clipboard")
        })
        .catch(()=>{
            alert("Failed to copy link")
        })
    }
</script>
</html>
