<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/link.css">
    <link rel="icon" href="/files/cake.png" type="image/png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <title>wishU | Link Created</title>
</head>
<body>

    <div class="container">

        <div class="box">

            <div class="success-icon">✓</div>

            <h1>Link Created!</h1>

            <p class="subtitle">
                Your wish is ready to share.
            </p>

            <div class="link-container">

                <a href="<%= link %>" id="shortLink" target="_blank" rel="noopener noreferrer">
                    <%= link %>
                </a>

                <button
                    class="copy-icon"
                    onclick="copyLink()"
                    aria-label="Copy link"
                    title="Copy link"
                    type="button"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="21"
                        height="21"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <rect x="8" y="8" width="13" height="13" rx="2"/>
                        <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>
                    </svg>
                </button>

            </div>

            <button class="copy-button" onclick="copyLink()" type="button">
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="19"
                    height="19"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                >
                    <rect x="8" y="8" width="13" height="13" rx="2"/>
                    <path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/>
                </svg>

                <span id="copyText">Copy Link</span>
            </button>

            <p id="copyMessage" class="copy-message" aria-live="polite"></p>

        </div>

        <a href="/home" class="home-button">
            ← Back to Home
        </a>

        <p class="footer-text">Made with care by wishU</p>

    </div>

    <script>
        async function copyLink() {
            const linkElement = document.getElementById("shortLink");
            const copyText = document.getElementById("copyText");
            const message = document.getElementById("copyMessage");

            const link = linkElement.href;

            try {
                await navigator.clipboard.writeText(link);

                copyText.textContent = "Copied!";
                message.textContent = "Link copied to clipboard!";

                setTimeout(() => {
                    copyText.textContent = "Copy Link";
                    message.textContent = "";
                }, 2000);

            } catch (error) {
                message.textContent =
                    "Unable to copy. Please copy the link manually.";

                console.error("Copy failed:", error);
            }
        }
    </script>

</body>
</html>
